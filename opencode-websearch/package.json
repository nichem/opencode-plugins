    "check:host": "node scripts/check-host.mjs",
    "check:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.0",
    "effect": "4.0.1",
    "jsonc-parser": "3.3.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "solid-js": "1.9.12"
  }
}
