{
  "name": "opencode-websearch",
  "version": "0.1.0",
  "private": true,
  "description": "Native web search provider picker and DeepSeek Search for OpenCode 2.x",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.js",
    "./rpc": "./src/rpc.js"
