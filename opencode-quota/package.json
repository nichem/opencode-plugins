{
  "name": "opencode-quota",
  "version": "2.1.0",
  "private": true,
  "description": "Show the selected model provider's quota in the OpenCode 2.x sidebar",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./tui": "./tui.tsx"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "src",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit && node --check src/script-worker.js",
    "test": "node --test tests/*.test.ts",
    "check:host": "node scripts/check-host.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "2.1.0",
    "effect": "4.0.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "2.1.0",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
