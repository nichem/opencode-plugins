{
  "name": "opencode-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Live thinking duration and a collapse footer for the OpenCode terminal UI",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tui": "./tui.js"
  },
  "files": [
    "tui.js",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:ui": "bun test --conditions=browser --preload @opentui/solid/preload ./tests/thinking.ui.mjs ./tests/native.ui.tsx",
    "check:host": "node scripts/check-host.mjs"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6"
  },
  "devDependencies": {
    "@opencode/plugin": "2.1.2",
    "@opentui/core": "0.6.6",
    "@opentui/solid": "0.6.6",
    "@types/node": "^24.0.0",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
