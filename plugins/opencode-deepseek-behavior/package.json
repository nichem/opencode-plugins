{
  "name": "opencode-deepseek-behavior",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent DeepSeek behavior prompt and sidebar toggle for OpenCode 2.x",
  "type": "module",
  "license": "MIT",
  "exports": { ".": "./index.ts", "./tui": "./tui.js" },
  "files": ["index.ts", "tui.js", "src", "README.md", "LICENSE"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build:tui": "node scripts/build-tui.mjs",
    "check": "tsc --noEmit && node scripts/build-tui.mjs --check",
    "test": "node --test tests/*.test.ts",
    "test:ui": "bun --conditions=browser test ./tests/sidebar.ui.ts",
    "check:host": "node scripts/check-host.mjs",
    "check:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": { "@opencode/plugin": "2.2.0", "effect": "4.0.1" },
  "peerDependencies": {
    "@opentui/core": ">=0.7.0", "@opentui/solid": ">=0.7.0", "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.27.1",
    "@opencode/theme": "2.2.0",
    "@opentui/core": "0.7.0",
    "@opentui/solid": "0.7.0",
    "@types/node": "^24.0.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "typescript": "5.9.3"
  }
}
